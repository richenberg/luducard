{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "Luducard",
  "version": "0.2.3",
  "identifier": "com.luducard.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luducard - Game Save Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Richenberg",
    "copyright": "Copyright (c) 2026 Richenberg. MIT licensed.",
    "homepage": "https://github.com/richenberg/luducard",
    "category": "Utility",
    "shortDescription": "Game save manager and community hub for PC.",
    "longDescription": "Luducard backs up and restores PC and emulator game saves, and adds a community hub where you can download save checkpoints and graphics presets shared by other players. Built in Rust. Free and open source."
  }
}
